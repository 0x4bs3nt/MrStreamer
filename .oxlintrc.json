{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Packages run without Electron: pass a capability in."
              },
              { "name": "react", "message": "Packages run without React." },
              { "name": "react-dom", "message": "Packages run without the DOM." },
              { "name": "mrstreamer", "message": "Packages don't depend on the app." }
            ],
            "patterns": [
              { "group": ["**/apps/**"], "message": "Packages don't depend on the app." }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contracts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "electron", "message": "Contracts are plain data." },
              { "name": "react", "message": "Contracts are plain data." }
            ],
            "patterns": [
              {
                "group": ["@mrstreamer/core", "@mrstreamer/core/*", "**/apps/**", "**/core/**"],
                "message": "Contracts depend on nothing else in the workspace."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/**", "apps/desktop/test/**"],
      "excludeFiles": ["apps/desktop/src/main/services/**", "apps/desktop/src/main/playback/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/playback/receiver-delivery", "**/playback/receiver-delivery.ts"],
                "message": "Receiver delivery belongs to Playback. Open sessions through the Playback service."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/main/services/**"],
      "excludeFiles": ["apps/desktop/src/main/services/playback.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ipc.ts", "**/handlers/**"],
                "message": "Services are independent of IPC transport and request adapters."
              },
              {
                "group": ["**/playback/receiver-delivery", "**/playback/receiver-delivery.ts"],
                "message": "Receiver delivery belongs to Playback. Open sessions through the Playback service."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/main/services/playback.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ipc.ts", "**/handlers/**"],
                "message": "Services are independent of IPC transport and request adapters."
              }
            ]
          }
        ]
      }
    }
  ]
}
