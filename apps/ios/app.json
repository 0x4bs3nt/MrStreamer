{
  "expo": {
    "name": "Mr. Streamer",
    "slug": "mrstreamer",
    "scheme": "mrstreamer",
    "version": "0.1.0",
    "platforms": ["ios"],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "experiments": {
      "tsconfigPaths": false
    },
    "ios": {
      "bundleIdentifier": "app.mrstreamer.player",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ]
    ]
  }
}
