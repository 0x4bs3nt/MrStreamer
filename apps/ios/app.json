{
  "expo": {
    "name": "Mr. Streamer",
    "slug": "mrstreamer",
    "scheme": "mrstreamer",
    "version": "0.0.0",
    "platforms": ["ios"],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.mrstreamer.player.dev",
      "supportsTablet": true
    },
    "plugins": [["expo-secure-store", { "faceIDPermission": false }]]
  }
}
