diff --git a/ios/Legacy/EXSessionTasks/EXSessionHandler.m b/ios/Legacy/EXSessionTasks/EXSessionHandler.m
index 8b1e4261d2194cd36ef4d14a1e809dca6dd9b35b..c18129ada6b72a6f3f9f8e37c87fe30d6b5beaac 100644
--- a/ios/Legacy/EXSessionTasks/EXSessionHandler.m
+++ b/ios/Legacy/EXSessionTasks/EXSessionHandler.m
@@ -43,6 +43,12 @@ EX_REGISTER_SINGLETON_MODULE(SessionHandler);
 
 - (void)application:(UIApplication *)application handleEventsForBackgroundURLSession:(NSString *)identifier completionHandler:(void (^)(void))completionHandler
 {
+  // Mr. Streamer: its own sessions are named by UUIDs (NetworkingHelpers.swift). Another owner's
+  // session is answered at once, so Expo's aggregate handler isn't left waiting on this one.
+  if ([[NSUUID alloc] initWithUUIDString:identifier] == nil) {
+    completionHandler();
+    return;
+  }
   _completionHandlers[identifier] = completionHandler;
 }
 
