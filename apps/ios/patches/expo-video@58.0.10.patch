+  /// AVKit's answer for a return from Picture in Picture, held until JavaScript has shown the view,
+  /// with the number its event carried.
+  private var pendingPictureInPictureRestore: (request: Int, completion: (Bool) -> Void)?
+  /// The number of the latest return this view asked JavaScript about.
+  private var pictureInPictureRestores = 0
+
+  // The viewer asked Picture in Picture to return to the app, rather than closing it. JavaScript
+  // shows this view again and then answers through finishPictureInPictureRestore with the event's
+  // request, so AVKit returns the picture into a view that is on screen. An earlier request still
+  // waiting is obsolete and answered no.
+  public func playerViewController(
+    _ playerViewController: AVPlayerViewController,
+    restoreUserInterfaceForPictureInPictureStopWithCompletionHandler completionHandler: @escaping (Bool) -> Void
+  ) {
+    cancelPictureInPictureRestore()
+    pictureInPictureRestores += 1
+    pendingPictureInPictureRestore = (pictureInPictureRestores, completionHandler)
+    onPictureInPictureRestore(["request": pictureInPictureRestores])
+  }
+
+  /// Answers the return `request` numbers, once, while it waits: true when the view is shown again.
+  /// An answer to an earlier request leaves a newer one waiting.
+  func finishPictureInPictureRestore(_ request: Int, _ restored: Bool) {
+    guard let pending = pendingPictureInPictureRestore, pending.request == request else {
+      return
+    }
+    pendingPictureInPictureRestore = nil
+    pending.completion(restored)
+  }
+
+  /// Answers no, once, to a return still waiting.
+  private func cancelPictureInPictureRestore() {
+    let pending = pendingPictureInPictureRestore
+    pendingPictureInPictureRestore = nil
+    pending?.completion(false)
+  }
+
