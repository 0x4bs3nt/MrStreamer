--- /dev/null
+++ b/ios/VideoPlayerObservationFacts.swift
@@ -0,0 +1,100 @@
+import AVFoundation
+import Foundation
+
+/// The asset is registered before its first load. Retirement also cancels a late registration.
+internal final class ObservedAssetLoad: @unchecked Sendable {
+  private let lock = NSLock()
+  private var retired = false
+  private var asset: AVAsset?
+  private var item: AVPlayerItem?
+
+  var constructedItem: AVPlayerItem? {
+    lock.lock()
+    defer { lock.unlock() }
+    return item
+  }
+
+  func registerItem(_ item: AVPlayerItem) {
+    lock.lock()
+    self.item = item
+    lock.unlock()
+  }
+
+  func register(_ asset: AVAsset) throws {
+    lock.lock()
+    self.asset = asset
+    let cancelled = retired
+    lock.unlock()
+    if cancelled { asset.cancelLoading(); throw CancellationError() }
+  }
+
+  func check() throws {
+    lock.lock()
+    let cancelled = retired
+    lock.unlock()
+    if cancelled || Task.isCancelled { throw CancellationError() }
+  }
+
+  func cancel() {
+    lock.lock()
+    retired = true
+    let asset = asset
+    lock.unlock()
+    asset?.cancelLoading()
+  }
+}
+
+internal enum ObservedFailure {
+  static func safeCode(domain: String, code: Int) -> [String: Any] {
+    let safeDomain: String
+    switch domain {
+    case AVFoundationErrorDomain: safeDomain = "avfoundation"
+    case NSURLErrorDomain: safeDomain = "url"
+    case "CoreMediaErrorDomain": safeDomain = "coremedia"
+    default: safeDomain = "other"
+    }
+    return ["domain": safeDomain, "code": code]
+  }
+
+  static func system(_ error: Error?, origin: String) -> [String: Any] {
+    guard let error else { return ["kind": "unknown", "evidence": NSNull()] }
+    let root = error as NSError
+    var underlying: [[String: Any]] = []
+    var visited: Set<ObjectIdentifier> = [ObjectIdentifier(root)]
+    var next = root.userInfo[NSUnderlyingErrorKey] as? NSError
+    while let child = next, underlying.count < 4, visited.insert(ObjectIdentifier(child)).inserted {
+      underlying.append(safeCode(domain: child.domain, code: child.code))
+      next = child.userInfo[NSUnderlyingErrorKey] as? NSError
+    }
+    var kind = "unknown"
+    if root.domain == NSURLErrorDomain {
+      switch root.code {
+      case URLError.Code.userAuthenticationRequired.rawValue: kind = "auth"
+      case URLError.Code.timedOut.rawValue, URLError.Code.networkConnectionLost.rawValue,
+        URLError.Code.notConnectedToInternet.rawValue, URLError.Code.dataNotAllowed.rawValue,
+        URLError.Code.cannotFindHost.rawValue, URLError.Code.dnsLookupFailed.rawValue,
+        URLError.Code.cannotConnectToHost.rawValue, URLError.Code.secureConnectionFailed.rawValue,
+        URLError.Code.serverCertificateUntrusted.rawValue: kind = "network"
+      default: break
+      }
+    } else if root.domain == AVFoundationErrorDomain {
+      switch root.code {
+      case AVError.Code.decodeFailed.rawValue, AVError.Code.decoderNotFound.rawValue: kind = "decode"
+      case AVError.Code.fileFormatNotRecognized.rawValue: kind = "unsupported"
+      default: break
+      }
+    }
+    return ["kind": kind, "evidence": [
+      "kind": "system", "origin": origin,
+      "code": safeCode(domain: root.domain, code: root.code), "underlying": underlying
+    ]]
+  }
+
+  static func errorLog(domain: String?, code: Int) -> [String: Any] {
+    // errorStatusCode is an opaque error identifier. Even 401/404/429 are not HTTP evidence.
+    ["kind": "unknown", "evidence": [
+      "kind": "system", "origin": "error-log", "code": safeCode(domain: domain ?? "", code: code),
+      "underlying": [] as [[String: Any]]
+    ]]
+  }
+}
