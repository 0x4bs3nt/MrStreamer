+// A media selection group can hold options with the same label and language, such as English
+// stereo and English surround, so an audio or subtitle record names its option by its position
+// among the group's options as well. That `id` belongs to the item that reported it.
+internal extension AVMediaSelectionGroup {
+  /// The `id` of a track record for `option`: its index among the group's options.
+  func trackId(of option: AVMediaSelectionOption) -> String? {
+    options.firstIndex(of: option).map(String.init)
+  }
+
+  /// The option a track record names: the one with its label and language and, when the record has
+  /// an `id`, at that index. A record without one names the first option with its label and language.
+  func option(trackId: String?, label: String?, language: String?) -> AVMediaSelectionOption? {
+    options.enumerated().first { index, option in
+      (trackId == nil || trackId == String(index))
+        && option.displayName == label
+        && option.locale?.identifier == language
+    }?.element
+  }
+}
