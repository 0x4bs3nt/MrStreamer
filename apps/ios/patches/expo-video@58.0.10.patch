diff --git a/ios/VideoPlayerObservation.swift b/ios/VideoPlayerObservation.swift
new file mode 100644
index 0000000000000000000000000000000000000000..35e9dc33c369edb14e796cd354e3f2f4df73510b
--- /dev/null
+++ b/ios/VideoPlayerObservation.swift
@@ -0,0 +1,399 @@
+import AVFoundation
+import ExpoModulesCore
+import Foundation
+
+internal final class ObservedPlaybackException: Exception {
+  private let fixedCode: String
+  init(_ fixedCode: String) { self.fixedCode = fixedCode; super.init() }
+  override var reason: String { fixedCode }
+  override var code: String { fixedCode }
+}
+
+internal struct ObservedItemIdentity: Record {
+  @Field var attemptId: Double = 0
+  @Field var itemId: Double = 0
+}
+
+internal final class ObservedAttempt {
+  let id: Double
+  let load = ObservedAssetLoad()
+  var loading: Task<VideoPlayerItem?, Error>?
+  var tracksLoading: Task<ObservedGroups, Never>?
+  var tracksReadId = 0
+  var closing: Task<[String: Any], Error>?
+  var retired = false
+  var attached = false
+  var item: VideoPlayerItem?
+  var itemId: Double?
+  var readySent = false
+  var terminalSent = false
+  var revision: Double = 0
+  var audio: AVMediaSelectionGroup?
+  var subtitles: AVMediaSelectionGroup?
+  var audioOptions: [AVMediaSelectionOption] = []
+  var subtitleOptions: [AVMediaSelectionOption] = []
+  var facts: NSDictionary?
+  var snapshot: [String: Any]?
+  var lastSnapshot: NSDictionary?
+
+  init(id: Double) { self.id = id }
+  func cancel() {
+    retired = true
+    load.cancel()
+    loading?.cancel()
+    tracksLoading?.cancel()
+  }
+}
+
+// Accessed only on main. One admission remains held until its real drain task settles.
+internal final class ObservedPlayerState {
+  var highWatermark: Double = 0
+  var retiredThrough: Double = 0
+  var nextItemId: Double = 0
+  var sequence: Double = 0
+  var current: ObservedAttempt?
+  var settlements: [Double: Task<[String: Any], Error>] = [:]
+}
+
+internal struct ObservedGroups {
+  let audio: AVMediaSelectionGroup?
+  let subtitles: AVMediaSelectionGroup?
+  let audioState: String
+  let subtitleState: String
+
+  @VideoLoadingActor
+  static func load(_ item: AVPlayerItem, ticket: ObservedAssetLoad) async -> ObservedGroups {
+    var audio: AVMediaSelectionGroup?
+    var subtitles: AVMediaSelectionGroup?
+    var audioState = "unavailable"
+    var subtitleState = "unavailable"
+    do {
+      try ticket.check()
+      audio = try await item.asset.loadMediaSelectionGroup(for: .audible)
+      try ticket.check()
+      audioState = audio == nil ? (item.status == .unknown ? "loading" : "absent") : "ready"
+      subtitles = try await item.asset.loadMediaSelectionGroup(for: .legible)
+      try ticket.check()
+      subtitleState = subtitles == nil ? (item.status == .unknown ? "loading" : "absent") : "ready"
+    } catch {
+      // A failed read is unknown availability, never proof of an empty group.
+    }
+    return ObservedGroups(audio: audio, subtitles: subtitles, audioState: audioState, subtitleState: subtitleState)
+  }
+}
+
+internal extension VideoPlayer {
+  func requireLegacyPlayback() throws {
+    if usesObservedPlayback { throw ObservedPlaybackException("ERR_OBSERVED_LEGACY_WRITE") }
+  }
+
+  @MainActor
+  func isObservedCurrent(_ attempt: ObservedAttempt) -> Bool {
+    observedState.current === attempt && !attempt.retired && !hasBeenReleased &&
+      attempt.attached && attempt.item != nil && ref.currentItem === attempt.item
+  }
+
+  @MainActor
+  func emitObserved(_ attempt: ObservedAttempt, kind: String, values: [String: Any] = [:]) {
+    observedState.sequence += 1
+    var event = values
+    event["version"] = 1
+    event["sequence"] = observedState.sequence
+    event["attemptId"] = attempt.id
+    event["itemId"] = attempt.itemId.map { $0 as Any } ?? NSNull()
+    event["kind"] = kind
+    if appContext != nil { emit(event: "playbackObservation", payload: event) }
+  }
+
+  @MainActor
+  func replaceObserved(source: VideoSource, attemptId: Double) async throws -> [String: Any] {
+    try validateObservedId(attemptId)
+    if attemptId <= observedState.retiredThrough {
+      return ["kind": "cancelled", "attemptId": attemptId]
+    }
+    guard attemptId > observedState.highWatermark else {
+      throw ObservedPlaybackException("ERR_OBSERVED_ATTEMPT_ORDER")
+    }
+    guard observedState.current == nil, ref.currentItem == nil, !videoSourceLoader.isLoading, !hasBeenReleased else {
+      throw ObservedPlaybackException("ERR_OBSERVED_NOT_DRAINED")
+    }
+    guard source.uri != nil else { throw ObservedPlaybackException("ERR_OBSERVED_SOURCE") }
+    beginObservedPlayback()
+    ref.pause()
+    observedState.highWatermark = attemptId
+    let attempt = ObservedAttempt(id: attemptId)
+    observedState.current = attempt
+    let loading = Task { @VideoLoadingActor [videoSourceLoader] in
+      try await videoSourceLoader.loadObserved(videoSource: source, load: attempt.load)
+    }
+    attempt.loading = loading
+    do {
+      let item = try await loading.value
+      bindObservedConstructedItem(attempt)
+      // This continuation and the attachment write both execute on main without another suspension.
+      guard observedState.current === attempt, !attempt.retired, !hasBeenReleased else {
+        return ["kind": "cancelled", "attemptId": attemptId]
+      }
+      guard let item, attempt.item === item else { throw ObservedPlaybackException("ERR_OBSERVED_SOURCE") }
+      if let drm = source.drm {
+        try drm.type.assertIsSupported()
+        contentKeyManager.addContentKeyRequest(videoSource: source, asset: item.urlAsset)
+      }
+      item.audioTimePitchAlgorithm = preservesPitch ? .spectral : .varispeed
+      item.preferredForwardBufferDuration = bufferOptions.preferredForwardBufferDuration
+      item.preferredMaximumResolution = maxResolution?.toCGSize() ?? .zero
+      ref.appliesMediaSelectionCriteriaAutomatically = false
+      ref.replaceCurrentItem(with: item)
+      guard ref.currentItem === item else { throw ObservedPlaybackException("ERR_OBSERVED_ATTACH") }
+      attempt.attached = true
+      updateObservedPlayerProperties()
+      // Synchronous replace KVO cannot publish ready/tracks before this commit.
+      emitObserved(attempt, kind: "attached")
+      let initialTracks: [String: Any] = [
+        "attemptId": attempt.id, "itemId": attempt.itemId!, "revision": 0,
+        "audio": ["state": "loading", "options": [] as [[String: Any]]],
+        "subtitles": ["state": "loading", "options": [] as [[String: Any]]],
+        "subtitleOffAllowed": false, "selectedAudioId": NSNull(), "selectedSubtitleId": NSNull()
+      ]
+      emitObserved(attempt, kind: "tracks", values: ["tracks": initialTracks])
+      observer?.observeManagedItem(attempt)
+      observeManagedItemState(attempt)
+      return ["kind": "attached", "attemptId": attemptId, "itemId": attempt.itemId!]
+    } catch {
+      bindObservedConstructedItem(attempt)
+      if attempt.retired || observedState.current !== attempt || error is CancellationError {
+        return ["kind": "cancelled", "attemptId": attemptId]
+      }
+      let failure = ObservedFailure.system(error, origin: "asset")
+      emitObserved(attempt, kind: "failure", values: ["terminal": true, "failure": failure])
+      return ["kind": "failed", "attemptId": attemptId,
+        "itemId": attempt.itemId.map { $0 as Any } ?? NSNull(), "failure": failure]
+    }
+  }
+
+  @MainActor
+  func detachObserved(attemptId: Double) async throws -> [String: Any] {
+    try validateObservedId(attemptId)
+    // Retirement precedes any await, including an open call not yet delivered by the bridge.
+    observedState.retiredThrough = max(observedState.retiredThrough, attemptId)
+    if let closed = observedState.settlements[attemptId] {
+      return try await closed.value
+    }
+    guard let attempt = observedState.current, attempt.id == attemptId else {
+      if attemptId > observedState.highWatermark {
+        // No admission ever owned this token, so its app-work set is already empty.
+        let receipt = detachReceipt(attemptId: attemptId, itemId: nil)
+        let closed = Task<[String: Any], Error> { receipt }
+        observedState.settlements[attemptId] = closed
+        emitObserved(ObservedAttempt(id: attemptId), kind: "detached", values: ["receipt": receipt])
+        return receipt
+      }
+      return ["kind": "obsolete", "attemptId": attemptId]
+    }
+    if let closing = attempt.closing { return try await closing.value }
+    attempt.cancel()
+    observer?.stopManagedItemObservations()
+    ref.pause()
+    if ref.currentItem === attempt.item, attempt.item != nil {
+      ref.replaceCurrentItem(with: nil)
+    }
+    let closing = Task { @MainActor [self, attempt] () async throws -> [String: Any] in
+      // Neither nil currentItem nor a timer proves that owned async operations have settled.
+      _ = try? await attempt.loading?.value
+      bindObservedConstructedItem(attempt)
+      _ = await attempt.tracksLoading?.value
+      guard attempt.item == nil || ref.currentItem !== attempt.item else {
+        throw ObservedPlaybackException("ERR_OBSERVED_DETACH_UNCERTAIN")
+      }
+      self.updateObservedPlayerProperties()
+      let receipt = detachReceipt(attemptId: attempt.id, itemId: attempt.itemId)
+      emitObserved(attempt, kind: "detached", values: ["receipt": receipt])
+      if observedState.current === attempt { observedState.current = nil }
+      return receipt
+    }
+    attempt.closing = closing
+    observedState.settlements[attemptId] = closing
+    return try await closing.value
+  }
+
+  @MainActor
+  func observeManagedItemState(_ attempt: ObservedAttempt) {
+    guard isObservedCurrent(attempt), let item = attempt.item else { return }
+    if item.status == .readyToPlay && !attempt.readySent {
+      attempt.readySent = true
+      observer?.notifyManagedItemReady(attempt)
+      let duration = item.duration.seconds
+      emitObserved(attempt, kind: "ready", values: ["durationSeconds": duration.isFinite ? duration as Any : NSNull()])
+      Task { @MainActor in _ = await self.refreshObservedTracks(attempt) }
+    }
+    if !attempt.terminalSent && (item.status == .failed || ref.status == .failed) {
+      attempt.terminalSent = true
+      // A terminal native error takes precedence over an earlier asset/group load error.
+      let itemError = item.status == .failed ? item.error : nil
+      let playerFailed = ref.status == .failed && itemError == nil
+      let error = itemError ?? (playerFailed ? ref.error : item.urlAsset.transportError)
+      emitObserved(attempt, kind: "failure", values: ["terminal": true,
+        "failure": ObservedFailure.system(error, origin: playerFailed ? "player" : "item")])
+    }
+    updateObservedPlayerProperties()
+    let time = ref.currentTime().seconds
+    emitObserved(attempt, kind: "state", values: [
+      "timeControl": ref.timeControlStatus == .playing ? "playing" : ref.timeControlStatus == .paused ? "paused" : "waiting",
+      "mediaTimeSeconds": time.isFinite ? time : 0,
+      "bufferEmpty": item.isPlaybackBufferEmpty, "likelyToKeepUp": item.isPlaybackLikelyToKeepUp
+    ])
+  }
+
+  @MainActor
+  func observedMediaServicesReset() {
+    guard let attempt = observedState.current, !attempt.retired else { return }
+    emitObserved(attempt, kind: "media-services-reset")
+  }
+
+  @MainActor
+  func getObservedTracks(_ expected: ObservedItemIdentity) async -> [String: Any] {
+    guard let attempt = expectedObservedAttempt(expected) else { return ["kind": "stale"] }
+    return await refreshObservedTracks(attempt)
+  }
+
+  @MainActor
+  func refreshObservedTracks(_ attempt: ObservedAttempt) async -> [String: Any] {
+    guard isObservedCurrent(attempt), let item = attempt.item else { return ["kind": "stale"] }
+    let loading: Task<ObservedGroups, Never>
+    let readId: Int
+    if let existing = attempt.tracksLoading {
+      loading = existing
+      readId = attempt.tracksReadId
+    } else {
+      attempt.tracksReadId += 1
+      readId = attempt.tracksReadId
+      loading = Task { @VideoLoadingActor in await ObservedGroups.load(item, ticket: attempt.load) }
+      attempt.tracksLoading = loading
+    }
+    let groups = await loading.value
+    guard isObservedCurrent(attempt), attempt.item === item else { return ["kind": "stale"] }
+    guard readId == attempt.tracksReadId else { return attempt.snapshot ?? ["kind": "stale"] }
+    attempt.tracksLoading = nil
+    let audioFacts = groupFacts(groups.audio, group: "audio")
+    let subtitleFacts = groupFacts(groups.subtitles, group: "subtitles")
+    let facts: NSDictionary = ["audio": audioFacts, "subtitles": subtitleFacts,
+      "audioState": groups.audioState, "subtitleState": groups.subtitleState,
+      "offAllowed": groups.subtitles?.allowsEmptySelection ?? false]
+    let groupsChanged = attempt.audio != groups.audio || attempt.subtitles != groups.subtitles ||
+      !sameObservedOptions(attempt.audioOptions, groups.audio?.options ?? []) ||
+      !sameObservedOptions(attempt.subtitleOptions, groups.subtitles?.options ?? [])
+    if groupsChanged || attempt.facts != facts {
+      attempt.revision += 1
+      attempt.facts = facts
+    }
+    attempt.audio = groups.audio
+    attempt.subtitles = groups.subtitles
+    attempt.audioOptions = groups.audio?.options ?? []
+    attempt.subtitleOptions = groups.subtitles?.options ?? []
+    let snapshot: [String: Any] = [
+      "attemptId": attempt.id, "itemId": attempt.itemId!, "revision": attempt.revision,
+      "audio": ["state": groups.audioState, "options": stampObservedTracks(audioFacts, attempt: attempt)],
+      "subtitles": ["state": groups.subtitleState, "options": stampObservedTracks(subtitleFacts, attempt: attempt)],
+      "subtitleOffAllowed": groups.subtitles?.allowsEmptySelection ?? false,
+      "selectedAudioId": selectedObservedId(item, group: groups.audio),
+      "selectedSubtitleId": selectedObservedId(item, group: groups.subtitles)
+    ]
+    attempt.snapshot = snapshot
+    let dictionary = snapshot as NSDictionary
+    if attempt.lastSnapshot != dictionary {
+      attempt.lastSnapshot = dictionary
+      emitObserved(attempt, kind: "tracks", values: ["tracks": snapshot])
+    }
+    return snapshot
+  }
+
+  @MainActor
+  func selectObservedTrack(_ expected: ObservedItemIdentity, revision: Double, selection: [String: Any]) async -> [String: Any] {
+    guard let attempt = expectedObservedAttempt(expected) else { return ["kind": "stale"] }
+    _ = await refreshObservedTracks(attempt)
+    guard isObservedCurrent(attempt), attempt.revision == revision, let item = attempt.item else {
+      return ["kind": "stale"]
+    }
