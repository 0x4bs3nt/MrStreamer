{
  "name": "mrstreamer",
  "productName": "Mr. Streamer",
  "version": "0.0.18",
  "description": "A clean, fast, open-source IPTV player for macOS, Windows and Linux.",
  "homepage": "https://mrstreamer.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Streamer-OSS/MrStreamer.git"
  },
  "bugs": "https://github.com/Mr-Streamer-OSS/MrStreamer/issues",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "desktopName": "mrstreamer.desktop",
  "author": "Wout Stiens",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:msix": "electron-vite build && electron-builder --win appx --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "icons:export": "node scripts/export-icons.ts",
    "dmg:background": "electron scripts/export-dmg-background.mjs 1 && electron scripts/export-dmg-background.mjs 2"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@mrstreamer/contracts": "workspace:*",
    "@mrstreamer/core": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@types/dns-packet": "5.6.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "arktype": "2.2.9",
    "class-variance-authority": "0.7.1",
    "dns-packet": "5.6.1",
    "effect": "4.0.0-rc.118",
    "electron": "44.9.3",
    "electron-builder": "26.15.7",
    "electron-updater": "6.8.11",
    "electron-vite": "5.0.0",
    "fflate": "0.8.3",
    "hls.js": "1.7.3",
    "lucide-react": "1.48.0",
    "mpegts.js": "1.8.2",
    "protobufjs": "8.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "zustand": "5.0.16"
  }
}
